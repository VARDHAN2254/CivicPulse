# ==============================================================================
# CivicPulse Root Git Ignore Rules
# ==============================================================================

# Environment files
.env
.env.local
.env.*.local
*.env

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
*.sublime-workspace
*.sublime-project

# Backend (Java / Maven)
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.log
*.log.*
hs_err_pid*

# Frontend (Node / Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.turbo/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Reports & Coverage
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local Docker Data Volumes (when run without named volumes)
postgres_data/
redis_data/
kafka_data/
prometheus_data/
grafana_data/

# Temporary / Scratch
tmp/
temp/
scratch/
