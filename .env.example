# ==============================================================================
# CivicPulse Environment Configuration
# Copy this file to .env and adjust variables as required for local deployment.
# NEVER commit .env with production credentials.
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# PostgreSQL Database Configuration
POSTGRES_DB=civicpulse_db
POSTGRES_USER=civicpulse_user
POSTGRES_PASSWORD=civicpulse_secure_password_dev_2026
POSTGRES_HOST=civicpulse-postgres
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://civicpulse-postgres:5432/civicpulse_db

# Redis Configuration
REDIS_HOST=civicpulse-redis
REDIS_PORT=6379
REDIS_PASSWORD=civicpulse_redis_pass_dev_2026
SPRING_DATA_REDIS_HOST=civicpulse-redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=civicpulse_redis_pass_dev_2026

# Apache Kafka Configuration (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=civicpulse-kafka:29092
SPRING_KAFKA_BOOTSTRAP_SERVERS=civicpulse-kafka:29092

# JWT Security Secrets (Must be at least 256 bits / 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# QR Token HMAC Secret Key
QR_TOKEN_SECRET_KEY=9d8a7c6b5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b

# Prometheus & Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=civicpulse_grafana_admin_2026
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
